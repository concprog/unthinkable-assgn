# Go backend
DATABASE_URL=postgres://user:pass@host:5432/lastmile
AUTH_SECRET=change-me-32-byte-hex
PORT=8080

# --- Email (Resend) ---
# Placeholder keys: get a free key at https://resend.com. With
# onboarding@resend.dev you can only send to your own account email;
# verify a domain in Resend to send to any address.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Last-Mile Tracker <onboarding@resend.dev>"

# Public URL of the frontend — used to build email-verification links
APP_URL=http://localhost:3000
